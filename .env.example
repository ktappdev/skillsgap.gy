# --- Web app (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo one-click login (testing phase only) ---
# Flag is browser-safe: it only controls whether the demo buttons render.
# Keep this false (or unset) in production.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Demo credentials are SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
# Create the matching auth users with: node --env-file=.env.local scripts/setup-demo-users.mjs
DEMO_APPLICANT_EMAIL=
DEMO_APPLICANT_PASSWORD=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_RECRUITER_EMAIL=
DEMO_RECRUITER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_PROVIDER_EMAIL=
DEMO_PROVIDER_PASSWORD=
# Optional: seeded demo company UUID used for owner/recruiter accounts.
DEMO_COMPANY_ID=10000000-0000-0000-0000-000000000001
# Optional: seeded demo provider UUID (defaults to Government Technical Institute / GTI)
DEMO_PROVIDER_ID=20000000-0000-0000-0000-000000000002

# --- Server-only (never expose to the browser) ---
# Used by scripts/setup-demo-users.mjs to provision demo accounts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Private processor/model runtime (server-only) ---
# The processor uses the OpenAI-compatible /v1/chat/completions contract.
# LLM_API_KEY may be empty for a keyless local server such as llama.cpp.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=
# Active qualification limit for processor CV extraction (default: 2000).
LLM_MAX_TAXONOMY_ENTRIES=2000
# The processor's own secrets (WEBHOOK_SECRET and the public-endpoint secrets)
# are set in services/processor/.env, not here. The skill-preview secret defaults
# to CSEC_SLIP_PROCESSOR_SECRET when its dedicated value is blank.
SKILL_PREVIEW_SECRET=

# --- CSEC/CXC result-slip reader (optional; server-only) ---
# The public pathway always supports manual entry. Configure these only after
# verifying that the configured model accepts image input.
CSEC_SLIP_PROCESSOR_URL=
CSEC_SLIP_PROCESSOR_SECRET=
# Configure this same secret on the processor as CSEC_SLIP_PROCESSOR_SECRET.

# --- Anonymous skill preview (optional; server-only) ---
# The signup form reuses the CSEC processor URL and secret when these are blank.
# Set these only when skill preview needs a separate processor or shared secret.
SKILL_PREVIEW_PROCESSOR_URL=
SKILL_PREVIEW_PROCESSOR_SECRET=
# Daily ceiling on anonymous previews across all visitors (default: 200).
SKILL_PREVIEW_GLOBAL_DAILY_LIMIT=200
